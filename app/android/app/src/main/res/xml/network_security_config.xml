<?xml version="1.0" encoding="utf-8"?>
<!-- Plain HTTP only to this device itself, so the app can reach the Nirnay engine on a laptop
     through `adb reverse tcp:8000 tcp:8000` (or 10.0.2.2 from the emulator). Every other
     host must use HTTPS, as Android requires by default. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
