{
  "model": "anomaly_detector",
  "version": "anomaly-v1",
  "dataset": "lt",
  "trained_on": "L&T Vehicle Loan Default (India), Aug-Sep 2018 (134,790 applications, labels not used)",
  "trained_at": "2026-11-05",
  "sklearn_version": "1.9.1",
  "params": {
    "n_estimators": 500,
    "max_samples": 8192,
    "random_state": 42,
    "n_jobs": -1
  },
  "thresholds": {
    "unusual": 0.5225139696546824,
    "very_unusual": 0.6133905353133029
  },
  "flag_share": {
    "unusual": 0.01,
    "very_unusual": 0.001
  },
  "features": [
    "log_loan_amount",
    "ltv",
    "ltv_gap",
    "bureau_score_or_0",
    "log_total_accounts",
    "log_overdue_accounts",
    "slog_outstanding",
    "log_sanctioned_total",
    "over_disbursed",
    "log_existing_emi",
    "log_new_accounts_6m",
    "log_recent_delinquencies",
    "log_enquiries",
    "credit_history_years",
    "history_before_18"
  ],
  "inputs": {
    "log_loan_amount": {
      "label": "Loan amount",
      "field": "loan_amount",
      "unit": "₹"
    },
    "ltv": {
      "label": "Loan-to-value",
      "field": "ltv",
      "unit": "%"
    },
    "ltv_gap": {
      "label": "Stated LTV vs loan ÷ asset cost (gap)",
      "field": null,
      "unit": "points"
    },
    "bureau_score_or_0": {
      "label": "Bureau score",
      "field": "bureau_score",
      "unit": ""
    },
    "log_total_accounts": {
      "label": "Loans in bureau report",
      "field": "total_accounts",
      "unit": ""
    },
    "log_overdue_accounts": {
      "label": "Overdue loans",
      "field": "overdue_accounts",
      "unit": ""
    },
    "slog_outstanding": {
      "label": "Outstanding balance",
      "field": "outstanding_balance",
      "unit": "₹"
    },
    "log_sanctioned_total": {
      "label": "Total sanctioned on past loans",
      "field": "sanctioned_total",
      "unit": "₹"
    },
    "over_disbursed": {
      "label": "Disbursed more than sanctioned",
      "field": null,
      "unit": "ratio"
    },
    "log_existing_emi": {
      "label": "Existing EMIs",
      "field": "existing_emi",
      "unit": "₹/month"
    },
    "log_new_accounts_6m": {
      "label": "New loans in last 6 months",
      "field": "new_accounts_6m",
      "unit": ""
    },
    "log_recent_delinquencies": {
      "label": "Loans defaulted in last 6 months",
      "field": "recent_delinquencies",
      "unit": ""
    },
    "log_enquiries": {
      "label": "Recent loan enquiries",
      "field": "enquiries",
      "unit": ""
    },
    "credit_history_years": {
      "label": "Years since first loan",
      "field": "credit_history_years",
      "unit": "years"
    },
    "history_before_18": {
      "label": "Credit history starting before age 18",
      "field": null,
      "unit": "years"
    }
  },
  "rules": {
    "ltv_mismatch": "Stated LTV differs from loan / asset cost by more than 10 points",
    "score_without_loans": "Bureau score present but no loans of any kind on record",
    "history_before_16": "Credit history would have started before age 16",
    "count_contradiction": "More active, overdue or defaulted loans than loans on record",
    "over_disbursed_2x": "Past loans disbursed at more than 2x the amount sanctioned"
